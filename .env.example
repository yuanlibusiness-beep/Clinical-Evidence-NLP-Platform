# Copy to .env and edit. Every value here has a working default, so the stack
# boots with an empty file -- the point of this project is that it runs before
# you have any credentials.
#
#   cp .env.example .env

# ---------------------------------------------------------------- application
ENVIRONMENT=local          # local | ci | staging | production
DEBUG=true
CORS_ORIGINS=http://localhost:3000

# Generate a real one before deploying anywhere:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app refuses to start in staging/production while this is the default.
JWT_SECRET=dev-only-insecure-secret-change-me

# ------------------------------------------------------------------- database
# SQLite (default): zero setup, vectors scored in NumPy. Good for development.
DATABASE_URL=sqlite:///./data/cenp.db
# PostgreSQL + pgvector (docker compose sets this automatically):
# DATABASE_URL=postgresql+psycopg://cenp:cenp@localhost:5432/cenp

# -------------------------------------------------------------------- workers
# Unset -> Celery runs tasks inline; no broker needed.
# REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=true

# ------------------------------------------------------------------------ llm
# LLM_PROVIDER=auto means: use the API when a key is present, otherwise fall
# back to the deterministic rule-based engine.
LLM_PROVIDER=auto
LLM_MODEL=llama-3.3-70b-versatile
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_TEMPERATURE=0.0

# Any OpenAI-compatible endpoint works, for example:
#   OpenAI     LLM_BASE_URL=https://api.openai.com/v1          LLM_MODEL=gpt-4o-mini
#   DeepSeek   LLM_BASE_URL=https://api.deepseek.com/v1        LLM_MODEL=deepseek-chat
#   local vLLM LLM_BASE_URL=http://localhost:8001/v1           LLM_MODEL=Qwen2.5-7B-Instruct

# ----------------------------------------------------------------- embeddings
# hashing: deterministic, local, no download -- works offline and in CI.
# openai_compatible: uses LLM_BASE_URL/LLM_API_KEY. Re-index after switching,
# and set EMBEDDING_DIM to the model's real dimension (1536 for
# text-embedding-3-small).
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=384

# ------------------------------------------------------------------ retrieval
CHUNK_TARGET_TOKENS=220
CHUNK_OVERLAP_TOKENS=40
RETRIEVAL_TOP_K_BM25=30
RETRIEVAL_TOP_K_VECTOR=30
RERANK_ENABLED=true
# Optional real cross-encoder (needs the `rerank` extra):
# RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ----------------------------------------------------------------- extraction
# A field is dropped unless its quote matches the source above
# GROUNDING_MIN_SIMILARITY and its calibrated confidence clears ABSTAIN_THRESHOLD.
ABSTAIN_THRESHOLD=0.45
GROUNDING_MIN_SIMILARITY=0.82
MAX_EVIDENCE_CHUNKS=14
PER_FIELD_EVIDENCE_CHUNKS=3

# -------------------------------------------------------------- external apis
# Optional: raises the NCBI rate limit from 3 to 10 requests/second.
PUBMED_API_KEY=
CONTACT_EMAIL=research@example.org
EXTERNAL_SEARCH_ENABLED=true

# -------------------------------------------------------------- observability
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --------------------------------------------------------------------- ports
API_PORT=8000
FRONTEND_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379
NEXT_PUBLIC_API_URL=http://localhost:8000
